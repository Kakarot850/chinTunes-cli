<?xml version="1.0" encoding="utf-8"?>
<!-- just_audio's LockCachingAudioSource serves the cached stream through a
     local HTTP proxy on 127.0.0.1. Android 9+ blocks cleartext by default, so
     allow it for loopback only. Everything else stays HTTPS-only (B-006). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
